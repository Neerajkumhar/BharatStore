# ==============================================================================
# BharatStore Environment Variables Configuration Template
# Copy this file to .env and replace placeholders with production values.
# DO NOT COMMIT REAL PRODUCTION SECRETS TO GIT REPOSITORIES.
# ==============================================================================

# Node Environment
NODE_ENV=production

# Application Base URL
NEXT_PUBLIC_APP_URL=https://bharatstore.in

# PostgreSQL Database Connection String
DATABASE_URL=postgresql://bharat_db_user:secure_password_here@localhost:5432/bharatstore?schema=public

# Authentication & Session Security
# REQUIRED in production — the app refuses to sign/verify sessions without it (fails closed).
# Must be a 64+ char random string.
JWT_SECRET=replace_with_a_strong_random_jwt_secret_token_in_production_min_64_chars

# Razorpay Payment Gateway (self-serve subscription upgrades)
# Keep real keys in .env.local (gitignored) — never commit secrets.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Notification Provider Credentials (Optional — System fails safely if omitted)
# EMAIL_API_KEY=resend_or_sendgrid_api_key_here
# SMS_API_KEY=twilio_or_fast2sms_api_key_here
# WHATSAPP_API_KEY=meta_whatsapp_business_api_token_here
