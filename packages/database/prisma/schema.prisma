datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// Identity & Access Management (Global & Tenant Memberships)
// -----------------------------------------------------------------------------

model User {
  id            String       @id @default(uuid()) @db.Uuid
  email         String       @unique
  phone         String       @unique
  passwordHash  String       @map("password_hash")
  fullName      String       @map("full_name")
  mfaEnabled    Boolean      @default(false) @map("mfa_enabled")
  mfaSecret     String?      @map("mfa_secret")
  isSuperAdmin  Boolean      @default(false) @map("is_superadmin")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  memberships   UserTenant[]
  sessions      Session[]
  auditLogs     AuditLog[]
  inventoryLogs InventoryLedger[]
  campaigns     Campaign[]
  platformLogs  PlatformAuditLog[]

  @@map("users")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  token        String   @unique
  userAgent    String?  @map("user_agent")
  ipAddress    String?  @map("ip_address")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Tenant {
  id                String   @id @default(uuid()) @db.Uuid
  legalName         String   @map("legal_name")
  tradeName         String   @map("trade_name")
  slug              String   @unique
  subdomain         String?  @unique
  customDomain      String?  @unique @map("custom_domain")
  gstin             String?  @db.VarChar(15)
  pan               String?  @db.VarChar(10)
  isCompositeScheme Boolean  @default(false) @map("is_composite_scheme")
  currency          String   @default("INR") @db.VarChar(3)
  phone             String   @db.VarChar(15)
  email             String?
  addressLine1      String   @map("address_line1")
  city              String
  stateCode         String   @map("state_code") @db.VarChar(2) // 2-digit Indian State code (e.g. 09 for UP, 27 for MH)
  pincode           String   @db.VarChar(6)
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relationships
  memberships       UserTenant[]
  roles             Role[]
  categories        Category[]
  products          Product[]
  variants          ProductVariant[]
  inventoryLogs     InventoryLedger[]
  customers         Customer[]
  khataRecords      KhataLedger[]
  orders            Order[]
  orderItems        OrderItem[]
  payments          Payment[]
  invoices          Invoice[]
  storefrontTheme   StorefrontTheme?
  storefrontPages   StorefrontPage[]
  campaigns         Campaign[]
  promotionRules    PromotionRule[]
  coupons           Coupon[]
  couponRedemptions CouponRedemption[]
  auditLogs         AuditLog[]
  securityEvents    SecurityEvent[]
  staffInvitations       StaffInvitation[]
  notifications          Notification[]
  notificationTemplates  NotificationTemplate[]
  notificationPreferences NotificationPreference[]
  subscription           TenantSubscription?
  subscriptionPayments   SubscriptionPayment[]
  featureOverrides       TenantFeatureOverride[]
  usage                  TenantUsage[]

  @@index([slug])
  @@index([stateCode])
  @@map("tenants")
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model UserTenant {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  roleId    String           @map("role_id") @db.Uuid
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role      Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@map("user_tenants")
}

model Role {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String?           @map("tenant_id") @db.Uuid // Null for standard system roles
  name             String            @db.VarChar(50)
  isSystemRole     Boolean           @default(false) @map("is_system_role")
  description      String?

  tenant           Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships      UserTenant[]
  permissions      RolePermission[]
  staffInvitations StaffInvitation[]

  @@unique([tenantId, name])
  @@map("roles")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model StaffInvitation {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  email       String
  roleId      String           @map("role_id") @db.Uuid
  tokenHash   String           @unique @map("token_hash")
  status      InvitationStatus @default(PENDING)
  invitedById String?          @map("invited_by_id") @db.Uuid
  expiresAt   DateTime         @map("expires_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role        Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([email])
  @@map("staff_invitations")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(100)
  description String?

  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// -----------------------------------------------------------------------------
// Catalog & Inventory Engine
// -----------------------------------------------------------------------------

model Category {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  parentId     String?    @map("parent_id") @db.Uuid
  name         String
  slug         String
  description  String?
  imageUrl     String?    @map("image_url")
  displayOrder Int        @default(0) @map("display_order")
  createdAt    DateTime   @default(now()) @map("created_at")

  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent       Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[] @relation("CategoryHierarchy")
  products     Product[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("categories")
}

model Product {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  categoryId   String           @map("category_id") @db.Uuid
  title        String
  slug         String
  description  String?
  hsnCode      String           @map("hsn_code") @db.VarChar(10)
  gstRate      Decimal          @map("gst_rate") @db.Decimal(5, 2)
  baseCost     Decimal          @default(0) @map("base_cost") @db.Decimal(12, 2)
  mrp          Decimal          @map("mrp") @db.Decimal(12, 2)
  sellingPrice Decimal          @map("selling_price") @db.Decimal(12, 2)
  isPublished  Boolean          @default(true) @map("is_published")
  images       String[]         @default([])
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category     Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants     ProductVariant[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, isPublished])
  @@map("products")
}

model ProductVariant {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  productId     String            @map("product_id") @db.Uuid
  sku           String            @db.VarChar(50)
  barcode       String?           @db.VarChar(50)
  variantName   String            @map("variant_name")
  priceOverride Decimal?          @map("price_override") @db.Decimal(12, 2)
  weightGrams   Int               @default(0) @map("weight_grams")
  currentStock  Int               @default(0) @map("current_stock")
  lowStockAlert Int               @default(5) @map("low_stock_alert")
  createdAt     DateTime          @default(now()) @map("created_at")

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product       Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryLogs InventoryLedger[]
  orderItems    OrderItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([productId])
  @@map("product_variants")
}

enum InventoryEventType {
  INWARD
  SALE
  RETURN
  DAMAGE
  ADJUSTMENT
}

model InventoryLedger {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  variantId      String             @map("variant_id") @db.Uuid
  changeQuantity Int                @map("change_quantity")
  balanceAfter   Int                @map("balance_after")
  eventType      InventoryEventType @map("event_type")
  referenceId    String?            @map("reference_id")
  notes          String?
  createdById    String?            @map("created_by_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at")

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant        ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdBy      User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, eventType])
  @@index([variantId])
  @@map("inventory_ledger")
}

// -----------------------------------------------------------------------------
// Customers & Khata Ledger (Credit)
// -----------------------------------------------------------------------------

model Customer {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  name           String
  phone          String             @db.VarChar(15)
  email          String?
  gstin          String?            @db.VarChar(15)
  creditLimit    Decimal            @default(0) @map("credit_limit") @db.Decimal(12, 2)
  currentBalance Decimal            @default(0) @map("current_balance") @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders         Order[]
  khataRecords   KhataLedger[]
  redemptions            CouponRedemption[]
  notifications          Notification[]
  notificationPreferences NotificationPreference[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@map("customers")
}

enum KhataEntryType {
  DEBIT_CREDIT_GIVEN
  CREDIT_PAYMENT_RECEIVED
}

model KhataLedger {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  customerId   String         @map("customer_id") @db.Uuid
  orderId      String?        @map("order_id") @db.Uuid
  type         KhataEntryType
  amount       Decimal        @db.Decimal(12, 2)
  balanceAfter Decimal        @map("balance_after") @db.Decimal(12, 2)
  paymentMode  String?        @map("payment_mode")
  notes        String?
  createdAt    DateTime       @default(now()) @map("created_at")

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order        Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([customerId])
  @@map("khata_ledger")
}

// -----------------------------------------------------------------------------
// Orders, Omnichannel POS & Payments
// -----------------------------------------------------------------------------

enum OrderChannel {
  STOREFRONT
  POS_COUNTER
  WHATSAPP
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

model Order {
  id              String             @id @default(uuid()) @db.Uuid
  tenantId        String             @map("tenant_id") @db.Uuid
  orderNumber     String             @map("order_number")
  customerId      String?            @map("customer_id") @db.Uuid
  couponId        String?            @map("coupon_id") @db.Uuid
  couponCode      String?            @map("coupon_code")
  channel         OrderChannel       @default(STOREFRONT)
  status          OrderStatus        @default(PENDING)
  paymentStatus   PaymentStatus      @default(UNPAID) @map("payment_status")
  subtotal        Decimal            @db.Decimal(12, 2)
  discountTotal   Decimal            @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxTotal        Decimal            @default(0) @map("tax_total") @db.Decimal(12, 2)
  shippingTotal   Decimal            @default(0) @map("shipping_total") @db.Decimal(12, 2)
  grandTotal      Decimal            @map("grand_total") @db.Decimal(12, 2)
  shippingAddress Json?              @map("shipping_address")
  billingAddress  Json?              @map("billing_address")
  notes           String?
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  coupon          Coupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  payments        Payment[]
  invoices        Invoice[]
  khataRecords    KhataLedger[]
  redemptions     CouponRedemption[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("orders")
}

model OrderItem {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  orderId      String         @map("order_id") @db.Uuid
  variantId    String         @map("variant_id") @db.Uuid
  productTitle String         @map("product_title")
  sku          String
  quantity     Int
  unitPrice    Decimal        @map("unit_price") @db.Decimal(12, 2)
  hsnCode      String         @map("hsn_code") @db.VarChar(10)
  gstRate      Decimal        @map("gst_rate") @db.Decimal(5, 2)
  cgstAmount   Decimal        @default(0) @map("cgst_amount") @db.Decimal(12, 2)
  sgstAmount   Decimal        @default(0) @map("sgst_amount") @db.Decimal(12, 2)
  igstAmount   Decimal        @default(0) @map("igst_amount") @db.Decimal(12, 2)
  lineTotal    Decimal        @map("line_total") @db.Decimal(12, 2)

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([orderId])
  @@map("order_items")
}

enum PaymentGateway {
  RAZORPAY
  CASHFREE
  UPI_DIRECT
  CASH
  MANUAL
}

enum PaymentRecordStatus {
  INITIATED
  SUCCESS
  FAILED
  REFUNDED
}

model Payment {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  orderId          String              @map("order_id") @db.Uuid
  amount           Decimal             @db.Decimal(12, 2)
  currency         String              @default("INR") @db.VarChar(3)
  gateway          PaymentGateway
  gatewayPaymentId String?             @map("gateway_payment_id")
  gatewayOrderId   String?             @map("gateway_order_id")
  status           PaymentRecordStatus @default(INITIATED)
  rawPayload       Json?               @map("raw_payload")
  createdAt        DateTime            @default(now()) @map("created_at")

  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order            Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([orderId])
  @@map("payments")
}

// -----------------------------------------------------------------------------
// GST Invoices & Compliance
// -----------------------------------------------------------------------------

enum InvoiceType {
  TAX_INVOICE
  BILL_OF_SUPPLY
  CREDIT_NOTE
}

model Invoice {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  orderId        String      @map("order_id") @db.Uuid
  invoiceNumber  String      @map("invoice_number")
  invoiceType    InvoiceType @default(TAX_INVOICE) @map("invoice_type")
  invoiceDate    DateTime    @default(now()) @map("invoice_date")
  supplierGstin  String      @map("supplier_gstin") @db.VarChar(15)
  recipientGstin String?     @map("recipient_gstin") @db.VarChar(15)
  placeOfSupply  String      @map("place_of_supply") @db.VarChar(2)
  totalCgst      Decimal     @default(0) @map("total_cgst") @db.Decimal(12, 2)
  totalSgst      Decimal     @default(0) @map("total_sgst") @db.Decimal(12, 2)
  totalIgst      Decimal     @default(0) @map("total_igst") @db.Decimal(12, 2)
  grandTotal     Decimal     @map("grand_total") @db.Decimal(12, 2)
  pdfStoragePath String?     @map("pdf_storage_path")
  createdAt      DateTime    @default(now()) @map("created_at")

  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([orderId])
  @@map("invoices")
}

// -----------------------------------------------------------------------------
// Storefront Themes & Marketing / Promotions Engine
// -----------------------------------------------------------------------------

model StorefrontTheme {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @unique @map("tenant_id") @db.Uuid
  themeName      String    @default("default") @map("theme_name")
  primaryColor   String    @default("#0f172a") @map("primary_color")
  accentColor    String    @default("#d97706") @map("accent_color")
  heroTitle      String?   @map("hero_title")
  heroSubtitle   String?   @map("hero_subtitle")
  heroBannerUrl  String?   @map("hero_banner_url")
  logoUrl        String?   @map("logo_url")
  description    String?
  businessHours  String?   @map("business_hours")
  contactPhone   String?   @map("contact_phone")
  contactEmail   String?   @map("contact_email")
  socialLinks      Json?     @map("social_links")
  isPublished      Boolean   @default(true) @map("is_published")
  publishedAt      DateTime? @map("published_at")
  draftConfig      Json?     @map("draft_config")
  publishedConfig  Json?     @map("published_config")

  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("storefront_themes")
}

// Builder-driven pages (home, about, contact, faq, policies, ...). Each page
// has its own draft (preview) + published (live) config, independent of the
// global StorefrontTheme which only holds store-level metadata.
model StorefrontPage {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  slug            String    @db.VarChar(100)
  title           String    @db.VarChar(200)
  navLabel        String?   @map("nav_label") @db.VarChar(100)
  showInMenu      Boolean   @default(false) @map("show_in_menu")
  isHome          Boolean   @default(false) @map("is_home")
  status          String    @default("DRAFT") // DRAFT | PUBLISHED
  draftConfig     Json?     @map("draft_config")
  publishedConfig Json?     @map("published_config")
  order           Int       @default(0)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("storefront_pages")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  ENDED
}

enum PromotionTarget {
  ALL_PRODUCTS
  SELECTED_PRODUCTS
  SELECTED_CATEGORIES
}

enum DiscountType {
  PERCENTAGE
  FLAT_AMOUNT
}

model Campaign {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  name        String
  description String?
  status      CampaignStatus @default(DRAFT)
  startAt     DateTime       @map("start_at")
  endAt       DateTime       @map("end_at")
  budget      Decimal?       @db.Decimal(12, 2)
  usageLimit  Int?           @map("usage_limit")
  usageCount  Int            @default(0) @map("usage_count")
  createdById String?        @map("created_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  promotions  PromotionRule[]
  coupons     Coupon[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("campaigns")
}

model PromotionRule {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  campaignId       String?         @map("campaign_id") @db.Uuid
  name             String
  discountType     DiscountType    @map("discount_type")
  discountValue    Decimal         @map("discount_value") @db.Decimal(10, 2)
  targetType       PromotionTarget @default(ALL_PRODUCTS) @map("target_type")
  targetIds        String[]        @default([]) @map("target_ids")
  minOrderValue    Decimal         @default(0) @map("min_order_value") @db.Decimal(10, 2)
  maxDiscount      Decimal?        @map("max_discount") @db.Decimal(10, 2)
  startAt          DateTime?       @map("start_at")
  endAt            DateTime?       @map("end_at")
  usageLimit       Int?            @map("usage_limit")
  usageCount       Int             @default(0) @map("usage_count")
  perCustomerLimit Int?            @map("per_customer_limit")
  isActive         Boolean         @default(true) @map("is_active")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign         Campaign?       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  coupons          Coupon[]

  @@index([tenantId])
  @@index([campaignId])
  @@map("promotion_rules")
}

model Coupon {
  id               String             @id @default(uuid()) @db.Uuid
  tenantId         String             @map("tenant_id") @db.Uuid
  campaignId       String?            @map("campaign_id") @db.Uuid
  promotionRuleId  String?            @map("promotion_rule_id") @db.Uuid
  code             String             @db.VarChar(30)
  discountType     DiscountType       @map("discount_type")
  discountValue    Decimal            @map("discount_value") @db.Decimal(10, 2)
  targetType       PromotionTarget    @default(ALL_PRODUCTS) @map("target_type")
  targetIds        String[]           @default([]) @map("target_ids")
  minOrderValue    Decimal            @default(0) @map("min_order_value") @db.Decimal(10, 2)
  maxDiscount      Decimal?           @map("max_discount") @db.Decimal(10, 2)
  validFrom        DateTime           @map("valid_from")
  validUntil       DateTime           @map("valid_until")
  usageLimit       Int?               @map("usage_limit")
  usageCount       Int                @default(0) @map("usage_count")
  perCustomerLimit Int?               @map("per_customer_limit")
  isActive         Boolean            @default(true) @map("is_active")
  createdAt        DateTime           @default(now()) @map("created_at")

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign         Campaign?          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  promotionRule    PromotionRule?     @relation(fields: [promotionRuleId], references: [id], onDelete: SetNull)
  redemptions      CouponRedemption[]
  orders           Order[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("coupons")
}

model CouponRedemption {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  couponId       String   @map("coupon_id") @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  customerId     String?  @map("customer_id") @db.Uuid
  customerPhone  String?  @map("customer_phone") @db.VarChar(15)
  discountAmount Decimal  @map("discount_amount") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  coupon         Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, couponId])
  @@index([tenantId, couponId, customerId])
  @@index([tenantId, couponId, customerPhone])
  @@map("coupon_redemptions")
}

// -----------------------------------------------------------------------------
// Security Center & Audit Trail (Append-Only)
// -----------------------------------------------------------------------------

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  actorEmail   String?  @map("actor_email")
  action       String   @db.VarChar(100)
  resourceType String   @map("resource_type") @db.VarChar(50)
  resourceId   String   @map("resource_id")
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent")
  beforeState  Json?    @map("before_state")
  afterState   Json?    @map("after_state")
  timestamp    DateTime @default(now())

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, timestamp])
  @@map("audit_logs")
}

enum SecuritySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model SecurityEvent {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String?          @map("tenant_id") @db.Uuid
  eventType String           @map("event_type") @db.VarChar(50)
  severity  SecuritySeverity @default(LOW)
  ipAddress String?          @map("ip_address") @db.VarChar(45)
  details   Json?
  timestamp DateTime         @default(now())

  tenant    Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([timestamp])
  @@map("security_events")
}

// -----------------------------------------------------------------------------
// Milestone 8: Notifications & Customer Engagement
// -----------------------------------------------------------------------------

enum NotificationType {
  ORDER_CONFIRMED
  ORDER_PACKED
  ORDER_DISPATCHED
  ORDER_DELIVERED
  PAYMENT_RECEIVED
  KHATA_PAYMENT_DUE
  LOW_STOCK
  CAMPAIGN
  COUPON
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Notification {
  id                String               @id @default(uuid()) @db.Uuid
  tenantId          String               @map("tenant_id") @db.Uuid
  customerId        String?              @map("customer_id") @db.Uuid
  type              NotificationType
  channel           NotificationChannel  @default(IN_APP)
  title             String
  message           String
  status            NotificationStatus   @default(PENDING)
  priority          NotificationPriority @default(NORMAL)
  isRead            Boolean              @default(false) @map("is_read")
  relatedEntityType String?              @map("related_entity_type")
  relatedEntityId   String?              @map("related_entity_id")
  scheduledAt       DateTime?            @map("scheduled_at")
  sentAt            DateTime?            @map("sent_at")
  deliveredAt       DateTime?            @map("delivered_at")
  readAt            DateTime?            @map("read_at")
  failureReason     String?              @map("failure_reason")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer          Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, type])
  @@index([tenantId, status])
  @@index([tenantId, isRead])
  @@index([tenantId, createdAt])
  @@map("notifications")
}

model NotificationTemplate {
  id        String              @id @default(uuid()) @db.Uuid
  tenantId  String              @map("tenant_id") @db.Uuid
  name      String
  type      NotificationType
  channel   NotificationChannel @default(IN_APP)
  subject   String?
  body      String
  variables String[]            @default([])
  isEnabled Boolean             @default(true) @map("is_enabled")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, type])
  @@map("notification_templates")
}

model NotificationPreference {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  customerId       String?             @map("customer_id") @db.Uuid
  orderUpdates     Boolean             @default(true) @map("order_updates")
  paymentUpdates   Boolean             @default(true) @map("payment_updates")
  marketing        Boolean             @default(true) @map("marketing")
  businessAlerts   Boolean             @default(true) @map("business_alerts")
  preferredChannel NotificationChannel @default(IN_APP) @map("preferred_channel")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer         Customer?           @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([tenantId, customerId])
  @@index([tenantId])
  @@map("notification_preferences")
}

// -----------------------------------------------------------------------------
// Super Admin Platform: Plans, Subscriptions, Feature Flags & Usage (M11)
// -----------------------------------------------------------------------------

model SubscriptionPlan {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @db.VarChar(50)
  slug          String    @unique @db.VarChar(50)
  description   String?
  monthlyPrice  Decimal   @map("monthly_price") @db.Decimal(10, 2)
  annualPrice   Decimal   @map("annual_price") @db.Decimal(10, 2)
  currency      String    @default("INR") @db.VarChar(3)
  maxProducts   Int       @default(50) @map("max_products")
  maxOrders     Int       @default(500) @map("max_orders")
  maxStaff      Int       @default(3) @map("max_staff")
  maxStorageMb  Int       @default(500) @map("max_storage_mb")
  features      String[]  @default([])
  isActive      Boolean   @default(true) @map("is_active")
  displayOrder  Int       @default(0) @map("display_order")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  subscriptions TenantSubscription[]
  planFeatures  PlanFeature[]
  payments      SubscriptionPayment[]

  @@index([isActive])
  @@map("subscription_plans")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  SUSPENDED
  EXPIRED
}

enum BillingPeriod {
  MONTHLY
  ANNUAL
}

model TenantSubscription {
  id                  String             @id @default(uuid()) @db.Uuid
  tenantId            String             @unique @map("tenant_id") @db.Uuid
  planId              String             @map("plan_id") @db.Uuid
  status              SubscriptionStatus @default(TRIAL)
  trialEndsAt         DateTime?          @map("trial_ends_at")
  currentPeriodStart  DateTime?          @map("current_period_start")
  currentPeriodEnd    DateTime?          @map("current_period_end")
  cancelAt            DateTime?          @map("cancel_at")
  cancelledAt         DateTime?          @map("cancelled_at")
  paymentMethod       String?            @map("payment_method") @db.VarChar(50)
  gatewaySubId        String?            @map("gateway_sub_id") @db.VarChar(100)
  billingPeriod       BillingPeriod      @default(MONTHLY) @map("billing_period")
  notes               String?
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId])
  @@index([status])
  @@map("tenant_subscriptions")
}

enum SubscriptionPaymentStatus {
  CREATED
  PAID
  FAILED
  CANCELLED
  EXPIRED
}

model SubscriptionPayment {
  id               String                  @id @default(uuid()) @db.Uuid
  tenantId         String                  @map("tenant_id") @db.Uuid
  planId           String                  @map("plan_id") @db.Uuid
  billingPeriod    BillingPeriod           @default(MONTHLY) @map("billing_period")
  amount           Int // smallest currency unit (paise)
  currency         String                  @default("INR") @db.VarChar(3)
  status           SubscriptionPaymentStatus @default(CREATED)
  gatewayOrderId   String?                 @unique @map("gateway_order_id") @db.VarChar(100)
  gatewayPaymentId String?                 @map("gateway_payment_id") @db.VarChar(100)
  gatewaySignature String?                 @map("gateway_signature")
  method           String?                 @db.VarChar(50)
  notes            String?
  paidAt           DateTime?               @map("paid_at")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([status])
  @@map("subscription_payments")
}

model FeatureFlag {
  id             String                   @id @default(uuid()) @db.Uuid
  slug           String                   @unique @db.VarChar(100)
  name           String                   @db.VarChar(100)
  description    String?
  category       String                   @db.VarChar(50)
  isPlatformWide Boolean                  @default(false) @map("is_platform_wide")
  isActive       Boolean                  @default(true) @map("is_active")
  displayOrder   Int                      @default(0) @map("display_order")
  createdAt      DateTime                 @default(now()) @map("created_at")

  planFeatures   PlanFeature[]
  overrides      TenantFeatureOverride[]

  @@index([category])
  @@index([isPlatformWide])
  @@index([isActive])
  @@map("feature_flags")
}

model PlanFeature {
  planId    String       @map("plan_id") @db.Uuid
  featureId String       @map("feature_id") @db.Uuid

  plan      SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature   FeatureFlag      @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([planId, featureId])
  @@index([featureId])
  @@map("plan_features")
}

model TenantFeatureOverride {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  featureId   String    @map("feature_id") @db.Uuid
  enabled     Boolean   @default(true)
  grantedById String?   @map("granted_by_id") @db.Uuid
  reason      String?
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feature     FeatureFlag @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([tenantId, featureId])
  @@index([featureId])
  @@map("tenant_feature_overrides")
}

model PlatformAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String   @map("actor_id") @db.Uuid
  actorEmail  String   @map("actor_email")
  action      String   @db.VarChar(100)
  targetType  String   @map("target_type") @db.VarChar(50)
  targetId    String?  @map("target_id") @db.Uuid
  targetName  String?  @map("target_name")
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  details     Json?
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at")

  actor       User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("platform_audit_logs")
}

model TenantUsage {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  period        String   @db.VarChar(7)
  productsCount Int      @default(0) @map("products_count")
  ordersCount   Int      @default(0) @map("orders_count")
  staffCount    Int      @default(0) @map("staff_count")
  storageUsedMb Decimal  @default(0) @map("storage_used_mb") @db.Decimal(10, 2)
  apiCalls      Int      @default(0) @map("api_calls")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, period])
  @@index([tenantId])
  @@map("tenant_usage")
}

